{
  "name": "neuro-desktop-pet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build",
    "test": "eslint . && node --test src/*.test.js",
    "electron": "electron .",
    "lint": "eslint .",
    "preview": "vite preview",
    "kill:ports": "powershell -ExecutionPolicy Bypass -File ./scripts/kill-ports.ps1",
    "start": "npm run kill:ports && concurrently -n backend,vite,electron -c yellow,cyan,green \"cd ../backend && python main.py\" \"vite --port 5173 --strictPort\" \"wait-on http://localhost:5173 && electron .\"",
    "backend:dist": "powershell -ExecutionPolicy Bypass -File ./scripts/build-backend.ps1",
    "dist": "npm run backend:dist && vite build && powershell -ExecutionPolicy Bypass -File ./scripts/clean-win-unpacked.ps1 && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.neuro.desktoppet",
    "productName": "Neuro桌宠",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "roaming.cjs",
      "vitalityModes.cjs",
      "windowState.cjs",
      "backendProcess.cjs",
      "public/models/**/*",
      "public/libs/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/models/PinkFox/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Neuro桌宠"
    }
  },
  "dependencies": {
    "@ricky0123/vad-react": "^0.0.36",
    "@ricky0123/vad-web": "^0.0.30",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "vite": "^6.0.5",
    "wait-on": "^8.0.0"
  }
}
